# NeuroPhenom AI — Environment Configuration
# Full-Stack Google Cloud Run / Development Server

# HTTP port (defaults to 3000 in development; Google Cloud Run sets PORT=8080)
PORT=8080

# Gemini API Key (Server-side proxy for Gemini 3.8 Flash, Gemini 3.8 Live, and Gemini 3.5 Transcribe)
GEMINI_API_KEY=your_gemini_api_key_here
